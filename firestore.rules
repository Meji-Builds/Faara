rules_version = '2';

// Faara Firestore security rules.
// Deploy: paste into Firebase Console → Firestore Database → Rules, or `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isValidUsername(name) {
      return name is string && name.matches('^[a-z0-9._]{3,20}$');
    }

    // Profiles: private to their owner. Created once during sign-up; tier changes are server-only.
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['fullName', 'username', 'phone', 'verificationTier', 'createdAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 80
        && isValidUsername(request.resource.data.username)
        // The phone must be the one verified by Firebase Auth.
        && request.resource.data.phone == request.auth.token.phone_number
        && request.resource.data.verificationTier == 1
        && request.resource.data.createdAt == request.time
        // The username must be reserved for this user in the same write.
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;

      // The only field people may change themselves: the public address of their dollar wallet.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletAddress'])
        && request.resource.data.walletAddress is string
        && request.resource.data.walletAddress.matches('^[1-9A-HJ-NP-Za-km-z]{32,44}$');
      allow delete: if false;

      // Push token and notification choices, read by the server when money arrives.
      match /private/push {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['tokens', 'moneyReceived', 'offers', 'updatedAt'])
          && request.resource.data.tokens is list
          && request.resource.data.tokens.size() <= 5
          && request.resource.data.moneyReceived is bool
          && request.resource.data.offers is bool;
      }

      // Settled payments, written by the server for both people.
      match /activity/{paymentId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Mock naira ledger: people can read their own balance; only the server moves money.
    match /ledgerAccounts/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /ledgerEntries/{reference} {
      allow read, write: if false;
    }

    // Top-ups in progress; server-only.
    match /fundingIntents/{reference} {
      allow read, write: if false;
    }

    // Faara's own server keys and offline pockets: server-only.
    match /serverKeys/{id} {
      allow read, write: if false;
    }
    match /circleWallets/{id} {
      allow read, write: if false;
    }
    match /circleWithdrawals/{id} {
      allow read, write: if false;
    }
    match /pockets/{id} {
      allow read, write: if false;
    }
    match /activePockets/{id} {
      allow read, write: if false;
    }
    match /offlineNotes/{id} {
      allow read, write: if false;
    }

    // Who brought someone to Faara (the owner of the pay link they opened). Write-once, private.
    match /referrals/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['referredBy', 'createdAt'])
        && isValidUsername(request.resource.data.referredBy)
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Username reservations make usernames unique. Anyone may check whether one exists.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;

      allow create: if signedIn()
        && isValidUsername(username)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        // One username per account, claimed together with the profile.
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update, delete: if false;
    }

    // Hums are written only by the server (Vercel functions with the Admin SDK).
    // The sender can read their hum; a claimant can read the hum they claimed.
    match /hums/{paymentId} {
      function isSender() {
        return signedIn() && get(/databases/$(database)/documents/hums/$(paymentId)).data.senderUid == request.auth.uid;
      }

      allow get: if signedIn()
        && (resource.data.senderUid == request.auth.uid
          || exists(/databases/$(database)/documents/hums/$(paymentId)/claims/$(request.auth.uid)));
      allow list, write: if false;

      // Claims are keyed by claimant uid. The sender sees all; each claimant sees their own.
      match /claims/{claimantUid} {
        allow get: if signedIn() && (claimantUid == request.auth.uid || isSender());
        allow list: if isSender();
        allow write: if false;
      }
    }

    // Server-only bookkeeping.
    match /humTokens/{token} {
      allow read, write: if false;
    }
    match /humManualCodes/{code} {
      allow read, write: if false;
    }
    match /settlements/{signature} {
      allow read, write: if false;
    }
    match /paymentPairs/{pair} {
      allow read, write: if false;
    }
    match /rateLimits/{key} {
      allow read, write: if false;
    }
  }
}
