{
  "expo": {
    "name": "Faara",
    "slug": "faara",
    "scheme": "faara",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A1412",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.faara.app"
    },
    "android": {
      "package": "com.faara.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#EAF7F2"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "faara-tau.vercel.app",
              "pathPrefix": "/pay"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Faara",
      "shortName": "Faara",
      "themeColor": "#0A1412",
      "backgroundColor": "#EAF7F2"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "backgroundColor": "#EAF7F2"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Faara uses the camera to scan a payment QR code when sound and Bluetooth can’t connect.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#14E0C1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "e3b0cb6d-7d07-4ced-ae3b-efd5b808436d"
      }
    }
  }
}
