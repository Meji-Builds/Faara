{
  "expo": {
    "name": "Faara",
    "slug": "faara",
    "scheme": "faara",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A1412",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.faara.app"
    },
    "android": {
      "package": "com.faara.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#0B3D2E"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Faara",
      "shortName": "Faara",
      "themeColor": "#0A1412",
      "backgroundColor": "#0A1412"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0B3D2E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Faara uses the camera to scan a payment QR code when sound and Bluetooth can’t connect.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "e3b0cb6d-7d07-4ced-ae3b-efd5b808436d"
      }
    }
  }
}
